# D-Trades ACC Backend — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Notion (backend token for M4 — not needed for M1)
NOTION_TOKEN=ntn_...
NOTION_COMMS_LOG_ID=49cabd64-a95d-44c3-853a-ec096114aaeb
NOTION_DECISION_LOG_ID=aaed4017-e2fb-407d-939c-88bbddc6bb24
NOTION_PIPELINE_ID=2b943df0-d336-4bb1-99a9-bbe8fe72b8ce
NOTION_PERFORMANCE_LOG_ID=e4a49a7f-a303-4b13-8575-f3cbd03ef331

# CORS — set to your Netlify domain once deployed
ALLOWED_ORIGIN=https://your-app.netlify.app

# Render — set automatically by Render, used by keep-alive ping
# RENDER_EXTERNAL_URL=https://your-render-app.onrender.com

PORT=3000
